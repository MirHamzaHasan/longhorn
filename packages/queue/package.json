{
  "name": "@longhorn/queue",
  "version": "0.1.0",
  "description": "Persistent jobs, leases and retries for LongHorn.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MirHamzaHasan/longhorn.git",
    "directory": "packages/queue"
  },
  "homepage": "https://mirhamzahasan.github.io/longhorn/",
  "bugs": "https://github.com/MirHamzaHasan/longhorn/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./transaction": {
      "types": "./dist/transaction.d.ts",
      "import": "./dist/transaction.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/memory.ts src/sqlite.ts src/postgres.ts src/transaction.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@longhorn/database": "workspace:*",
    "@longhorn/validation": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false
}
