{
  "name": "@longhornjs/core",
  "version": "0.1.0",
  "description": "The LongHorn application: start, listen, drain and close.",
  "keywords": [
    "longhorn",
    "typescript",
    "backend",
    "framework",
    "hono",
    "web-standards",
    "multi-runtime",
    "application-lifecycle"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MirHamzaHasan/longhorn.git",
    "directory": "packages/core"
  },
  "homepage": "https://longhorn.run/",
  "bugs": "https://github.com/MirHamzaHasan/longhorn/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@longhornjs/container": "workspace:*",
    "@longhornjs/http": "workspace:*",
    "@longhornjs/runtime": "workspace:*",
    "@longhornjs/logger": "workspace:*"
  }
}
