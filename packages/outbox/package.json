{
  "name": "@longhornjs/outbox",
  "version": "0.1.0",
  "description": "Transactional delivery, recovery and audit for LongHorn.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MirHamzaHasan/longhorn.git",
    "directory": "packages/outbox"
  },
  "homepage": "https://mirhamzahasan.github.io/longhorn/",
  "bugs": "https://github.com/MirHamzaHasan/longhorn/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/sqlite.ts src/postgres.ts src/hono.ts src/http.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@longhornjs/database": "workspace:*",
    "@longhornjs/queue": "workspace:*",
    "@longhornjs/validation": "workspace:*",
    "@longhornjs/http": "workspace:*",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false
}
