{
  "name": "@longhorn/auth",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    "./bearer": {
      "types": "./dist/bearer.d.ts",
      "import": "./dist/bearer.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./scrypt": {
      "types": "./dist/scrypt.d.ts",
      "import": "./dist/scrypt.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/hono.ts src/sqlite.ts src/postgres.ts src/bearer.ts src/scrypt.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@longhorn/database": "workspace:*",
    "hono": "^4.13.13"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false
}
