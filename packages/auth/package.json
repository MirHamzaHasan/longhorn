{
  "name": "@longhornjs/auth",
  "version": "0.1.0",
  "description": "Passwords, sessions and guards for LongHorn applications.",
  "keywords": [
    "longhorn",
    "typescript",
    "backend",
    "framework",
    "hono",
    "web-standards",
    "authentication",
    "sessions",
    "passwords"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MirHamzaHasan/longhorn.git",
    "directory": "packages/auth"
  },
  "homepage": "https://longhorn.run/",
  "bugs": "https://github.com/MirHamzaHasan/longhorn/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./bearer": {
      "types": "./dist/bearer.d.ts",
      "import": "./dist/bearer.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./scrypt": {
      "types": "./dist/scrypt.d.ts",
      "import": "./dist/scrypt.js"
    },
    "./sqlite-passwords": {
      "types": "./dist/sqlite-passwords.d.ts",
      "import": "./dist/sqlite-passwords.js"
    },
    "./postgres-passwords": {
      "types": "./dist/postgres-passwords.d.ts",
      "import": "./dist/postgres-passwords.js"
    },
    "./sqlite-session-controls": {
      "types": "./dist/sqlite-session-controls.d.ts",
      "import": "./dist/sqlite-session-controls.js"
    },
    "./postgres-session-controls": {
      "types": "./dist/postgres-session-controls.d.ts",
      "import": "./dist/postgres-session-controls.js"
    },
    "./session-inventory": {
      "types": "./dist/session-inventory.d.ts",
      "import": "./dist/session-inventory.js"
    },
    "./sqlite-session-inventory": {
      "types": "./dist/sqlite-session-inventory.d.ts",
      "import": "./dist/sqlite-session-inventory.js"
    },
    "./postgres-session-inventory": {
      "types": "./dist/postgres-session-inventory.d.ts",
      "import": "./dist/postgres-session-inventory.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/hono.ts src/sqlite.ts src/postgres.ts src/bearer.ts src/scrypt.ts src/sqlite-passwords.ts src/postgres-passwords.ts src/sqlite-session-controls.ts src/postgres-session-controls.ts src/session-inventory.ts src/sqlite-session-inventory.ts src/postgres-session-inventory.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@longhornjs/database": "workspace:*",
    "hono": "^4.13.13"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false
}
