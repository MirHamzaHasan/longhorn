{
  "name": "@longhorn/cache",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/memory.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "files": [
    "dist"
  ],
  "sideEffects": false
}
