{
  "name": "@longhornjs/cache",
  "version": "0.1.0",
  "description": "Memory or Redis caching with shared loads for LongHorn.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MirHamzaHasan/longhorn.git",
    "directory": "packages/cache"
  },
  "homepage": "https://mirhamzahasan.github.io/longhorn/",
  "bugs": "https://github.com/MirHamzaHasan/longhorn/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "import": "./dist/redis.js"
    },
    "./json": {
      "types": "./dist/codec.d.ts",
      "import": "./dist/codec.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/memory.ts src/redis.ts src/codec.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "files": [
    "dist"
  ],
  "sideEffects": false
}
