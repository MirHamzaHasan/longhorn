{
  "name": "@longhorn/config",
  "version": "0.1.0",
  "description": "Validated configuration for LongHorn applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MirHamzaHasan/longhorn.git",
    "directory": "packages/config"
  },
  "homepage": "https://mirhamzahasan.github.io/longhorn/",
  "bugs": "https://github.com/MirHamzaHasan/longhorn/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@longhorn/validation": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "devDependencies": {
    "zod": "^4.6.7"
  }
}
