{
  "name": "@longhorn/http",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    "./client": { "types": "./dist/client.d.ts", "import": "./dist/client.js" },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/client.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ]
}
