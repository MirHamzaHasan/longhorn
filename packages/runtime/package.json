      "types": "./dist/prune-worker.d.ts",
      "import": "./dist/prune-worker.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/prune-worker.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "sideEffects": false,
  "files": [
    "dist"
  ]
