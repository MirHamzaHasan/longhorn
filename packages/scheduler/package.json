{
  "name": "@longhorn/scheduler",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cron": {
      "types": "./dist/cron.d.ts",
      "import": "./dist/cron.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cron.ts src/memory.ts src/sqlite.ts src/postgres.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@longhorn/database": "workspace:*",
    "@longhorn/queue": "workspace:*"
  },
  "devDependencies": { "@longhorn/validation": "workspace:*" },
  "files": ["dist"],
  "sideEffects": false
}
