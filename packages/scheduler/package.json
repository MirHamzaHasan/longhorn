{
  "name": "@longhornjs/scheduler",
  "version": "0.1.0",
  "description": "Durable one-time, interval and cron runs for LongHorn.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MirHamzaHasan/longhorn.git",
    "directory": "packages/scheduler"
  },
  "homepage": "https://mirhamzahasan.github.io/longhorn/",
  "bugs": "https://github.com/MirHamzaHasan/longhorn/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cron": {
      "types": "./dist/cron.d.ts",
      "import": "./dist/cron.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cron.ts src/memory.ts src/sqlite.ts src/postgres.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@longhornjs/database": "workspace:*",
    "@longhornjs/queue": "workspace:*"
  },
  "devDependencies": {
    "@longhornjs/validation": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false
}
