{
  "name": "@longhorn/validation",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/hono.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.4.1",
    "@standard-schema/spec": "^1.1.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@longhorn/http": "workspace:*",
    "zod": "^4.6.7"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ]
}
