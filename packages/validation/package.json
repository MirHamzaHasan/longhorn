{
  "name": "@longhornjs/validation",
  "version": "0.1.0",
  "description": "Standard Schema parsing and Hono input for LongHorn.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MirHamzaHasan/longhorn.git",
    "directory": "packages/validation"
  },
  "homepage": "https://mirhamzahasan.github.io/longhorn/",
  "bugs": "https://github.com/MirHamzaHasan/longhorn/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/hono.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.4.0",
    "@standard-schema/spec": "^1.1.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@longhornjs/http": "workspace:*",
    "zod": "^4.6.7"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ]
}
