{
  "name": "@longhornjs/database",
  "version": "0.1.0",
  "description": "SQL, transactions and checksummed migrations for LongHorn.",
  "keywords": [
    "longhorn",
    "typescript",
    "backend",
    "framework",
    "hono",
    "web-standards",
    "sql",
    "migrations",
    "transactions",
    "sqlite",
    "postgresql"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MirHamzaHasan/longhorn.git",
    "directory": "packages/database"
  },
  "homepage": "https://longhorn.run/",
  "bugs": "https://github.com/MirHamzaHasan/longhorn/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./sqlite-statement": {
      "types": "./dist/sqlite-statement.d.ts",
      "import": "./dist/sqlite-statement.js"
    },
    "./batch": {
      "types": "./dist/batch.d.ts",
      "import": "./dist/batch.js"
    },
    "./transactions": {
      "types": "./dist/transactions.d.ts",
      "import": "./dist/transactions.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/postgres.ts src/transactions.ts src/batch.ts src/sqlite-statement.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "sideEffects": false,
  "files": [
    "dist"
  ]
}
