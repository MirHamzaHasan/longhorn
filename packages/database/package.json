{
  "name": "@longhorn/database",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    "./batch": {
      "types": "./dist/batch.d.ts",
      "import": "./dist/batch.js"
    },
    "./transactions": {
      "types": "./dist/transactions.d.ts",
      "import": "./dist/transactions.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/postgres.ts src/transactions.ts src/batch.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "sideEffects": false,
  "files": [
    "dist"
  ]
}
