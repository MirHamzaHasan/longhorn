{
  "name": "@longhorn/idempotency",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    "./batch-sqlite": { "types": "./dist/batch-sqlite.d.ts", "import": "./dist/batch-sqlite.js" },
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./sqlite": { "types": "./dist/sqlite.d.ts", "import": "./dist/sqlite.js" },
    "./postgres": { "types": "./dist/postgres.d.ts", "import": "./dist/postgres.js" }
  },
  "scripts": {
    "build": "tsup src/index.ts src/sqlite.ts src/postgres.ts src/batch-sqlite.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "@longhorn/database": "workspace:*" },
  "files": ["dist"],
  "sideEffects": false
}
