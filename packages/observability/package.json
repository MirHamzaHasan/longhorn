{
  "name": "@longhornjs/observability",
  "version": "0.1.0",
  "description": "Health, metrics, traces and OTLP export for LongHorn.",
  "keywords": [
    "longhorn",
    "typescript",
    "backend",
    "framework",
    "hono",
    "web-standards",
    "observability",
    "metrics",
    "tracing",
    "opentelemetry"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MirHamzaHasan/longhorn.git",
    "directory": "packages/observability"
  },
  "homepage": "https://longhorn.run/",
  "bugs": "https://github.com/MirHamzaHasan/longhorn/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    },
    "./prometheus": {
      "types": "./dist/prometheus.d.ts",
      "import": "./dist/prometheus.js"
    },
    "./otlp-logs": {
      "types": "./dist/otlp-logs.d.ts",
      "import": "./dist/otlp-logs.js"
    },
    "./otlp-metrics": {
      "types": "./dist/otlp-metrics.d.ts",
      "import": "./dist/otlp-metrics.js"
    },
    "./otlp": {
      "types": "./dist/otlp.d.ts",
      "import": "./dist/otlp.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/hono.ts src/prometheus.ts src/memory.ts src/otlp.ts src/otlp-metrics.ts src/otlp-logs.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "@longhornjs/logger": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false
}
