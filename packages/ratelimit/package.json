{
  "name": "@longhorn/ratelimit",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "import": "./dist/redis.js"
    },
    "./batch-sqlite": {
      "types": "./dist/batch-sqlite.d.ts",
      "import": "./dist/batch-sqlite.js"
    },
    "./cleanup": {
      "types": "./dist/cleanup.d.ts",
      "import": "./dist/cleanup.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/memory.ts src/sqlite.ts src/postgres.ts src/hono.ts src/redis.ts src/batch-sqlite.ts src/cleanup.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@longhorn/database": "workspace:*",
    "hono": "^4.13.13",
    "@longhorn/runtime": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false
}
