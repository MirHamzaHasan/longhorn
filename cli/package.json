{
  "name": "@longhornjs/cli",
  "version": "0.1.0",
  "description": "The LongHorn CLI and project generator.",
  "keywords": [
    "longhorn",
    "typescript",
    "backend",
    "framework",
    "hono",
    "web-standards",
    "cli",
    "scaffolding"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MirHamzaHasan/longhorn.git",
    "directory": "cli"
  },
  "homepage": "https://longhorn.run/",
  "bugs": "https://github.com/MirHamzaHasan/longhorn/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean && node scripts/snapshot.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "bin": {
    "longhorn": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@longhornjs/outbox": "workspace:*",
    "@longhornjs/ratelimit": "workspace:*",
    "@longhornjs/idempotency": "workspace:*",
    "@types/node": "^22.13.10",
    "@longhornjs/container": "workspace:*",
    "@longhornjs/runtime": "workspace:*",
    "@longhornjs/http": "workspace:*",
    "@longhornjs/logger": "workspace:*",
    "@longhornjs/validation": "workspace:*",
    "@longhornjs/config": "workspace:*",
    "@longhornjs/database": "workspace:*",
    "@longhornjs/core": "workspace:*",
    "@longhornjs/node": "workspace:*",
    "@longhornjs/bun": "workspace:*",
    "@longhornjs/deno": "workspace:*",
    "@longhornjs/workers": "workspace:*",
    "@longhornjs/auth": "workspace:*",
    "@longhornjs/events": "workspace:*",
    "@longhornjs/cache": "workspace:*",
    "@longhornjs/queue": "workspace:*",
    "@longhornjs/scheduler": "workspace:*",
    "@longhornjs/observability": "workspace:*"
  }
}
