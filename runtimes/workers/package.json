{
  "name": "@longhornjs/workers",
  "version": "0.1.0",
  "description": "Cloudflare Workers host for LongHorn, with D1 and Durable Objects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MirHamzaHasan/longhorn.git",
    "directory": "runtimes/workers"
  },
  "homepage": "https://mirhamzahasan.github.io/longhorn/",
  "bugs": "https://github.com/MirHamzaHasan/longhorn/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./d1": {
      "types": "./dist/d1.d.ts",
      "import": "./dist/d1.js"
    },
    "./outbox": {
      "types": "./dist/outbox.d.ts",
      "import": "./dist/outbox.js"
    },
    "./sqlite-alarms": {
      "types": "./dist/sqlite-alarms.d.ts",
      "import": "./dist/sqlite-alarms.js"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "import": "./dist/queue.js"
    },
    "./durable-sqlite": {
      "types": "./dist/durable-sqlite.d.ts",
      "import": "./dist/durable-sqlite.js"
    },
    "./scheduled": {
      "types": "./dist/scheduled.d.ts",
      "import": "./dist/scheduled.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/scheduled.ts src/durable-sqlite.ts src/d1.ts src/queue.ts src/sqlite-alarms.ts src/outbox.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@longhornjs/database": "workspace:*",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@longhornjs/runtime": "workspace:*"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@longhornjs/core": "workspace:*"
  }
}
