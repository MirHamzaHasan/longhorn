{
  "name": "@longhorn/node",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./passwords": {
      "types": "./dist/passwords.d.ts",
      "import": "./dist/passwords.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "import": "./dist/redis.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "import": "./dist/process.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/config.ts src/sqlite.ts src/passwords.ts src/postgres.ts src/redis.ts src/process.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@longhorn/queue": "workspace:*",
    "@longhorn/scheduler": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@libsql/client": "^0.18.0",
    "@longhorn/auth": "workspace:*",
    "@longhorn/config": "workspace:*",
    "@longhorn/database": "workspace:*",
    "@longhorn/runtime": "workspace:*",
    "@redis/client": "6.3.0",
    "pg": "8.23.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
