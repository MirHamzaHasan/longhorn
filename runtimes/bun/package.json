{
  "name": "@longhorn/bun",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/sqlite.ts --format esm --dts --external bun:sqlite --clean",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "dependencies": {
    "@longhorn/database": "workspace:*",
    "@longhorn/runtime": "workspace:*"
  }
}
