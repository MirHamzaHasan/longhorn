{
  "name": "@longhorn/bun",
  "version": "0.1.0",
  "description": "Native Bun host for LongHorn, with bun:sqlite.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MirHamzaHasan/longhorn.git",
    "directory": "runtimes/bun"
  },
  "homepage": "https://mirhamzahasan.github.io/longhorn/",
  "bugs": "https://github.com/MirHamzaHasan/longhorn/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./passwords": {
      "types": "./dist/passwords.d.ts",
      "import": "./dist/passwords.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/sqlite.ts src/passwords.ts --format esm --dts --external bun:sqlite --clean",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "dependencies": {
    "@longhorn/database": "workspace:*",
    "@longhorn/runtime": "workspace:*",
    "@longhorn/auth": "workspace:*"
  }
}
