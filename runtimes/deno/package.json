{
  "name": "@longhorn/deno",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./passwords": {
      "types": "./dist/passwords.d.ts",
      "import": "./dist/passwords.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/sqlite.ts src/passwords.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/deno": "^2.7.0",
    "@types/node": "^22.13.10"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "dependencies": {
    "@longhorn/runtime": "workspace:*",
    "@longhorn/database": "workspace:*",
    "@longhorn/auth": "workspace:*"
  }
}
