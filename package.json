{
  "name": "longhorn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "bun-runtime": "npm:bun@1.4.4",
    "deno-runtime": "npm:deno@2.9.6",
    "embedded-postgres": "18.4.0-beta.17",
    "miniflare": "3.20250718.3",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  },
  "scripts": {
    "test:sqlite-project": "pnpm build && node scripts/verify-sqlite-project.mjs",
    "test:d1-project": "pnpm build && node scripts/verify-d1-project.mjs",
    "test:d1-idempotency": "pnpm build && node scripts/verify-d1-idempotency.mjs",
    "dev:d1": "pnpm --filter example-d1-worker... build && node scripts/serve-d1-worker.mjs",
    "test:d1": "pnpm build && node scripts/verify-d1.mjs",
    "test:otlp-logs": "pnpm build && node scripts/verify-otlp-logs.mjs",
    "demo:logs": "pnpm build && node scripts/demo-logs.mjs",
    "test:otlp-metrics": "pnpm build && node scripts/verify-otlp-metrics.mjs",
    "demo:metrics": "pnpm build && node scripts/demo-metrics.mjs",
    "dev:redis-cache": "pnpm --filter example-basic... build && node examples/basic/dist/redis-index.js",
    "test:redis-cache": "pnpm build && node scripts/verify-redis-cache.mjs",
    "package:command-app": "pnpm build && node scripts/package-command-app.mjs",
    "test:command-app": "pnpm build && node scripts/verify-command-app.mjs",
    "test:console": "pnpm build && node scripts/verify-console.mjs",
    "test:command-history": "pnpm build && node scripts/verify-command-history.mjs",
    "test:persistent-operations": "pnpm build && node scripts/verify-persistent-operations.mjs",
    "dev:operator-host": "pnpm --filter example-postgres... build && node examples/postgres/dist/operator-host.js",
    "dev:message-receiver": "pnpm --filter example-outbox-worker... build && node scripts/serve-message-receiver.mjs",
    "test:operator-accounts": "pnpm build && node scripts/verify-operator-accounts.mjs",
    "demo:operator-accounts": "pnpm build && node scripts/demo-operator-accounts.mjs",
    "operator:postgres": "pnpm --filter example-postgres... build && node examples/postgres/dist/operator-role.js",
    "migrate:account-operations": "pnpm --filter example-postgres... build && node examples/postgres/dist/migrate-operations.js",
    "test:outbox-audit": "pnpm build && node scripts/verify-outbox-audit.mjs",
    "test:outbox-recovery": "pnpm build && node scripts/verify-outbox-recovery.mjs",
    "dev:outbox-worker": "pnpm --filter example-outbox-worker... build && node scripts/serve-outbox-worker.mjs",
    "test:outbox": "pnpm build && node scripts/verify-outbox.mjs",
    "test:idempotency": "pnpm build && node scripts/verify-idempotency.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "dev": "pnpm --filter example-basic dev",
    "predev": "pnpm --filter example-basic^... build",
    "test:persistence": "pnpm build && node scripts/verify-persistence.mjs",
    "test:runtimes": "pnpm build && node scripts/verify-runtimes.mjs",
    "dev:bun": "pnpm --filter example-portable... build && bun examples/portable/dist/bun.js",
    "dev:deno": "pnpm --filter example-portable... build && deno run --no-prompt --no-lock --node-modules-dir=manual --allow-net=127.0.0.1 --allow-env=HOST,PORT,LOG_LEVEL examples/portable/dist/deno.js",
    "dev:workers": "pnpm --filter example-portable... build && node scripts/serve-worker.mjs",
    "dev:scheduled-worker": "pnpm --filter example-scheduled-worker... build && node scripts/serve-scheduled-worker.mjs",
    "dev:durable-worker": "pnpm --filter example-durable-worker... build && node scripts/serve-durable-worker.mjs",
    "dev:queue-worker": "pnpm --filter example-queue-worker... build && node scripts/serve-queue-worker.mjs",
    "dev:alarm-worker": "pnpm --filter example-durable-worker... build && node scripts/serve-alarm-worker.mjs",
    "test:worker-alarms": "pnpm build && node scripts/verify-worker-alarms.mjs",
    "test:transaction-publishing": "pnpm build && node scripts/verify-transaction-publishing.mjs",
    "test:worker-queues": "pnpm build && node scripts/verify-worker-queues.mjs",
    "test:worker-storage": "pnpm build && node scripts/verify-worker-storage.mjs",
    "test:worker-scheduled": "pnpm build && node scripts/verify-worker-scheduled.mjs",
    "create:app": "pnpm --filter create-longhorn... build && node create-longhorn/dist/bin.js",
    "longhorn": "node cli/dist/bin.js",
    "test:projects": "pnpm build && node scripts/verify-projects.mjs",
    "dev:auth": "pnpm --filter example-auth^... build && pnpm --filter example-auth dev",
    "test:auth": "pnpm build && node scripts/verify-auth.mjs",
    "test:events": "pnpm build && node scripts/verify-events.mjs",
    "test:cache": "pnpm build && node scripts/verify-cache.mjs",
    "dev:jobs": "pnpm --filter example-jobs^... build && pnpm --filter example-jobs dev",
    "test:queues": "pnpm build && node scripts/verify-queues.mjs",
    "test:scheduler": "pnpm build && node scripts/verify-scheduler.mjs",
    "test:observability": "pnpm build && node scripts/verify-observability.mjs",
    "test:otlp": "pnpm build && node scripts/verify-otlp.mjs",
    "demo:tracing": "pnpm build && node scripts/demo-tracing.mjs",
    "test:postgres": "pnpm build && node scripts/verify-postgres.mjs",
    "dev:postgres": "pnpm --filter example-postgres^... build && pnpm --filter example-postgres dev",
    "migrate:postgres": "pnpm --filter example-postgres^... build && pnpm --filter example-postgres migrate",
    "demo:postgres": "pnpm build && node scripts/demo-postgres.mjs",
    "test:bun-sqlite": "pnpm build && node scripts/verify-bun-sqlite.mjs",
    "dev:bun-sqlite": "pnpm --filter example-bun-sqlite... build && bun examples/bun-sqlite/dist/index.js",
    "test:bun-sqlite-project": "pnpm build && node scripts/verify-sqlite-project.mjs bun"
  },
  "packageManager": "pnpm@12.6.0"
}
