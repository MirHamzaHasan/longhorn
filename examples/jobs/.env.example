HOST=127.0.0.1
PORT=3002
LOG_LEVEL=info
DATABASE_PATH=./data/jobs.sqlite
WORKER_ENABLED=true
SCHEDULER_ENABLED=true
SHUTDOWN_GRACE_MS=0
# Remote tracing is opt-in; without an endpoint /traces retains the local buffer.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=authorization=Bearer%20your-token
# OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=10000
# OTEL_SERVICE_NAME=longhorn-jobs
# Metrics push is independently opt-in; /metrics remains available for scraping.
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://127.0.0.1:4318/v1/metrics
# OTEL_EXPORTER_OTLP_METRICS_HEADERS=authorization=Bearer%20your-token
# OTEL_EXPORTER_OTLP_METRICS_TIMEOUT=10000
# OTEL_METRIC_EXPORT_INTERVAL=60000
# Generated per process unless supplied; keep concurrent instances distinct.
# OTEL_SERVICE_INSTANCE_ID=your-unique-instance
