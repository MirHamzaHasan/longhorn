    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@longhornjs/outbox": "workspace:*",
    "@longhornjs/idempotency": "workspace:*",
    "@longhornjs/config": "workspace:*",
    "@longhornjs/container": "workspace:*",
    "@longhornjs/core": "workspace:*",
    "@longhornjs/database": "workspace:*",
    "@longhornjs/logger": "workspace:*",
    "@longhornjs/node": "workspace:*",
    "@longhornjs/observability": "workspace:*",
    "@longhornjs/queue": "workspace:*",
    "@longhornjs/scheduler": "workspace:*",
    "@longhornjs/validation": "workspace:*",
    "hono": "^4.13.13",
    "zod": "^4.6.7",
    "@longhornjs/http": "workspace:*"
  },
  "devDependencies": {
    "@longhornjs/auth": "workspace:*",
    "@types/node": "^22.13.10",
    "tsx": "^4.20.0"
  }
