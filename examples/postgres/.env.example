# Use separate migration owner and restricted runtime roles in a database you own.
DATABASE_URL=postgres://longhorn_app:change-me@127.0.0.1:5432/longhorn
MIGRATION_DATABASE_URL=postgres://longhorn_owner:change-me@127.0.0.1:5432/longhorn
HOST=127.0.0.1
PORT=3003
LOG_LEVEL=info
PG_MAX_CONNECTIONS=5
WORKER_ENABLED=true
SCHEDULER_ENABLED=true
AUTH_ORIGIN=http://127.0.0.1:3003
AUTH_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
