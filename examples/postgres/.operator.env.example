# Runtime-only profile. Deploy with migrate:account-operations and provision through a separate shell.
DATABASE_URL=postgres://longhorn_app:change-me@127.0.0.1:5432/longhorn
HOST=127.0.0.1
PORT=3011
LOG_LEVEL=info
PG_MAX_CONNECTIONS=5
AUTH_ORIGIN=http://127.0.0.1:3011
AUTH_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
# Base URL ends in /. Only explicit loopback development permits HTTP.
MESSAGE_SERVICE_URL=http://127.0.0.1:3012/
MESSAGE_SERVICE_TOKEN=replace-me
MESSAGE_ALLOW_INSECURE_LOOPBACK=true
MESSAGE_HTTP_TIMEOUT_MS=2000
DISPATCH_ENABLED=true
