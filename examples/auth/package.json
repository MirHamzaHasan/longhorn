{
  "name": "example-auth",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts src/bun.ts src/deno.ts src/app.ts src/config.ts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:bun": "bun dist/bun.js",
    "start:deno": "deno run --no-prompt --no-lock --node-modules-dir=manual --allow-net=127.0.0.1 --allow-env=HOST,PORT,AUTH_ORIGIN,AUTH_COOKIE_SECURE,SESSION_TTL_SECONDS,DATABASE_PATH,LOG_LEVEL --allow-read=data --allow-write=data dist/deno.js"
  },
  "dependencies": {
    "@longhorn/auth": "workspace:*",
    "@longhorn/config": "workspace:*",
    "@longhorn/container": "workspace:*",
    "@longhorn/core": "workspace:*",
    "@longhorn/database": "workspace:*",
    "@longhorn/logger": "workspace:*",
    "@longhorn/node": "workspace:*",
    "@longhorn/validation": "workspace:*",
    "hono": "^4.13.13",
    "zod": "^4.6.7",
    "@longhorn/bun": "workspace:*",
    "@longhorn/deno": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.20.0",
    "@types/bun": "^1.4.4",
    "@types/deno": "^2.7.0"
  }
}
