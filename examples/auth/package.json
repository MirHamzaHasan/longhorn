{
  "name": "example-auth",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts src/bun.ts src/deno.ts src/app.ts src/config.ts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:bun": "bun dist/bun.js",
    "start:deno": "deno run --no-prompt --no-lock --node-modules-dir=manual --allow-net=127.0.0.1 --allow-env=HOST,PORT,AUTH_ORIGIN,AUTH_COOKIE_SECURE,SESSION_TTL_SECONDS,DATABASE_PATH,LOG_LEVEL --allow-read=data --allow-write=data dist/deno.js"
  },
  "dependencies": {
    "@longhornjs/auth": "workspace:*",
    "@longhornjs/config": "workspace:*",
    "@longhornjs/container": "workspace:*",
    "@longhornjs/core": "workspace:*",
    "@longhornjs/database": "workspace:*",
    "@longhornjs/logger": "workspace:*",
    "@longhornjs/node": "workspace:*",
    "@longhornjs/validation": "workspace:*",
    "hono": "^4.13.13",
    "zod": "^4.6.7",
    "@longhornjs/bun": "workspace:*",
    "@longhornjs/deno": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.20.0",
    "@types/bun": "^1.4.3",
    "@types/deno": "^2.7.0"
  }
}
