HOST=127.0.0.1
PORT=3028
LOG_LEVEL=info
# Generate a private 32..256-character base64url/hex token; keep it out of source control.
API_TOKEN=replace_with_a_private_random_token_at_least_32_characters
RATE_LIMIT_SUBJECT=service-client
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000
REDIS_NAMESPACE=reports
# Production uses rediss with verified TLS. This opt-in is for local loopback only.
REDIS_URL=redis://default:replace_with_redis_password@127.0.0.1:6379/0
REDIS_ALLOW_INSECURE_LOOPBACK=true
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=2000
